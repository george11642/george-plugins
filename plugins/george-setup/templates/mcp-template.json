{
  "mcpServers": {
    "gemini": {
      "type": "stdio",
      "command": "node",
      "args": [
        "$HOME/.claude/mcp-servers/gemini-mcp/dist/index.js"
      ],
      "env": {
        "GEMINI_API_KEY": "YOUR_GEMINI_API_KEY_HERE"
      }
    },
    "ios-simulator": {
      "type": "stdio",
      "command": "node",
      "args": [
        "$HOME/.claude/mcp-servers/ios-simulator-mcp/dist/index.js"
      ],
      "env": {
        "IOS_SSH_HOST": "localhost",
        "IOS_SSH_PORT": "50922",
        "IOS_SSH_USER": "user",
        "IOS_SSH_PASS": "alpine"
      }
    },
    "latex": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "$HOME/.claude/scripts/latex-mcp-wrapper.sh"
      ],
      "env": {
        "PDFLATEX_PATH": "/usr/bin/pdflatex"
      }
    }
  },
  "_README": "Copy this to ~/.claude/.mcp.json. Replace YOUR_*_HERE placeholders. Run npm install && npm run build in each MCP server directory before use."
}
