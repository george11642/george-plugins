{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "0",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(uv --version:*)"
    ],
    "defaultMode": "dontAsk"
  },
  "disabledMcpjsonServers": [
    "ios-simulator",
    "stitch",
    "latex"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/quality-gate.js\""
          },
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/screenshot-verify.js\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/gsd-check-update.js\""
          },
          {
            "type": "command",
            "command": "/home/george/.claude/scripts/patch-chrome-plugin-configs.sh"
          },
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/boot.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/context-tracker.js\""
          },
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/self-heal.js\""
          },
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/mid-session-skill-loader.js\""
          },
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/budget-breaker.js\""
          },
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/sycophancy-check.js\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/router.js\""
          },
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/gate-enforcer.js\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/dangerous-cmd-block.js\""
          },
          {
            "type": "command",
            "command": "/home/george/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/readonly-guard.js\""
          },
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/convention-check.js\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/george/.claude/hooks/precompact-handoff.js\"",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"/home/george/.claude/hooks/statusline.js\""
  },
  "enabledPlugins": {
    "superpowers-chrome@superpowers-marketplace": true,
    "ralph-gsd@george-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "disabledPlugins": {
    "context7@claude-plugins-official": "not part of the minimal default set",
    "superpowers@superpowers-marketplace": "absorbed into process overlays (brainstorming, TDD, etc.)",
    "claude-session-driver@superpowers-marketplace": "replaced by orchestrator skill",
    "claude-code-setup@claude-plugins-official": "one-time use, not needed always",
    "episodic-memory@superpowers-marketplace": "replaced by progressive memory in behavior.json",
    "agent-sdk-dev@claude-plugins-official": "not essential",
    "code-simplifier@claude-plugins-official": "absorbed into domain skills",
    "content-marketing@claude-code-workflows": "not essential",
    "debugging-toolkit@claude-code-workflows": "absorbed into domain skills",
    "developer-essentials@claude-code-workflows": "absorbed into domain skills",
    "framework-migration@claude-code-workflows": "not essential",
    "frontend-mobile-development@claude-code-workflows": "absorbed into domain skills",
    "javascript-typescript@claude-code-workflows": "absorbed into domain skills",
    "python-development@claude-code-workflows": "absorbed into domain skills",
    "security-guidance@claude-plugins-official": "absorbed into domain skills",
    "shell-scripting@claude-code-workflows": "absorbed into domain skills",
    "hookify@claude-plugins-official": "extra command surface, not part of the minimal default set",
    "commit-commands@claude-plugins-official": "extra git command surface, not part of the minimal default set",
    "plugin-dev@claude-plugins-official": "plugin authoring helpers are not part of the daily default set",
    "sentry@claude-plugins-official": "enable only when needed for incident work",
    "stripe@claude-plugins-official": "enable only when needed for billing work",
    "posthog@claude-plugins-official": "enable only when needed for analytics work",
    "figma@claude-plugins-official": "enable only when needed for design work",
    "claude-md-management@claude-plugins-official": "extra authoring helpers, not part of the minimal default set",
    "github@claude-plugins-official": "gh cli already covers day-to-day GitHub work",
    "supabase@claude-plugins-official": "MCP handles this directly",
    "ui-design@claude-code-workflows": "absorbed into domain skills",
    "vercel@claude-plugins-official": "not essential for daily use"
  },
  "mcpServers": {
    "clerk": {
      "type": "http",
      "url": "https://mcp.clerk.com/mcp"
    }
  }
}
