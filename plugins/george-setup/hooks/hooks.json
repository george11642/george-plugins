{
  "description": "George Setup hooks: orchestration engine (auto-loaded), context monitor, and memory reminders",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/install.sh\" 2>/dev/null || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node -e \"process.stdout.write(require('fs').readFileSync(require('path').join(process.env.CLAUDE_PLUGIN_ROOT,'skills','orchestration-engine','SKILL.md'),'utf8'))\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/context-monitor.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/memory-reminder.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
